  "components": [
    {
      "name": "Film Button",
      "kind": "button",
      "refersTo": "tool-film",
      "description": "The one orange fill: plays the whole build as a 12 fps film.",
      "html": "<button class=\"ds-tool ds-tool-film\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polygon points=\"6 3 20 12 6 21 6 3\"/></svg><span>Play the film</span></button>",
      "css": ".ds-tool{--paper:#dcd8cf;--panel:#f1eee7;--ink:#232420;--ink-2:#57564f;--hair:rgba(35,36,32,.16);--signal:#f04a00;--wash:rgba(35,36,32,.07);font-family:'Google Sans Flex Variable','Helvetica Neue',sans-serif;font-variation-settings:'ROND' 100;height:36px;min-width:36px;padding:0 12px;display:inline-flex;align-items:center;justify-content:center;gap:8px;border-radius:10px;border:1px solid var(--hair);background:transparent;color:var(--ink);font-size:14px;font-weight:600;cursor:pointer}.ds-tool:hover{background:var(--wash)}.ds-tool:focus-visible{outline:2px solid var(--signal);outline-offset:2px}.ds-tool-film{background:var(--signal);border-color:var(--signal);color:#fff}.ds-tool-film:hover{background:#d84200}"
    },
    {
      "name": "Tool Button",
      "kind": "button",
      "refersTo": "tool",
      "description": "Hairline ghost tool with an 18px Lucide icon at stroke 1.75.",
      "html": "<button class=\"ds-tool\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 7V5a2 2 0 0 1 2-2h2\"/><path d=\"M17 3h2a2 2 0 0 1 2 2v2\"/><path d=\"M21 17v2a2 2 0 0 1-2 2h-2\"/><path d=\"M7 21H5a2 2 0 0 1-2-2v-2\"/></svg><span>Fit</span></button>",
      "css": ".ds-tool{--paper:#dcd8cf;--panel:#f1eee7;--ink:#232420;--ink-2:#57564f;--hair:rgba(35,36,32,.16);--signal:#f04a00;--wash:rgba(35,36,32,.07);font-family:'Google Sans Flex Variable','Helvetica Neue',sans-serif;font-variation-settings:'ROND' 100;height:36px;min-width:36px;padding:0 12px;display:inline-flex;align-items:center;justify-content:center;gap:8px;border-radius:10px;border:1px solid var(--hair);background:transparent;color:var(--ink);font-size:14px;font-weight:600;cursor:pointer}.ds-tool:hover{background:var(--wash)}.ds-tool:focus-visible{outline:2px solid var(--signal);outline-offset:2px}"
    },
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Ink-filled confirm, used once in the picker.",
      "html": "<button class=\"ds-primary\">Start building</button>",
      "css": ".ds-primary{--paper:#dcd8cf;--panel:#f1eee7;--ink:#232420;--ink-2:#57564f;--hair:rgba(35,36,32,.16);--signal:#f04a00;--wash:rgba(35,36,32,.07);font-family:'Google Sans Flex Variable','Helvetica Neue',sans-serif;font-variation-settings:'ROND' 100;height:44px;padding:0 22px;border-radius:12px;border:1px solid var(--ink);background:var(--ink);color:var(--panel);font-size:15px;font-weight:660;cursor:pointer}.ds-primary:focus-visible{outline:2px solid var(--signal);outline-offset:2px}.ds-primary:disabled{background:transparent;color:var(--ink-2);border-color:var(--hair);cursor:default}"
    },
    {
      "name": "Goal Pad",
      "kind": "custom",
      "refersTo": "pad",
      "description": "Press for a 2x2, hold for a 2x4. The primary action.",
      "html": "<button class=\"ds-pad\"><span class=\"ds-pad-brick\"><svg viewBox=\"-24 -21 48 48\" width=\"48\" height=\"48\" aria-hidden=\"true\"><polygon points=\"22.5,13 22.5,-2.6 0,10.4 0,26\" fill=\"#8d1206\"/><polygon points=\"-22.5,13 0,26 0,10.4 -22.5,-2.6\" fill=\"#ad1608\"/><polygon points=\"0,-15.6 22.5,-2.6 0,10.4 -22.5,-2.6\" fill=\"#c91a09\"/></svg></span><span class=\"ds-pad-name\">Build</span><span class=\"ds-pad-count\">128</span></button>",
      "css": ".ds-pad{--paper:#dcd8cf;--panel:#f1eee7;--ink:#232420;--ink-2:#57564f;--hair:rgba(35,36,32,.16);--signal:#f04a00;--wash:rgba(35,36,32,.07);font-family:'Google Sans Flex Variable','Helvetica Neue',sans-serif;font-variation-settings:'ROND' 100;width:92px;display:grid;justify-items:center;align-items:end;padding:6px 4px 8px;border:1px solid transparent;border-radius:14px;background:transparent;color:var(--ink);cursor:pointer}.ds-pad:hover{background:var(--wash);border-color:var(--hair)}.ds-pad:focus-visible{outline:2px solid var(--signal);outline-offset:2px}.ds-pad-brick{display:flex;align-items:flex-end;justify-content:center;height:58px}.ds-pad-brick svg{filter:drop-shadow(0 3px 2px rgba(20,19,17,.3))}.ds-pad:active .ds-pad-brick{transform:translateY(2px)}.ds-pad-name{margin-top:4px;font-size:13px;font-weight:650}.ds-pad-count{font-size:12px;font-weight:540;color:var(--ink-2);font-variant-numeric:tabular-nums}"
    },
    {
      "name": "Step Numeral",
      "kind": "custom",
      "description": "Day N of building, the lead type of the day panel.",
      "html": "<div class=\"ds-step\">41<span class=\"ds-step-unit\">day</span></div><p class=\"ds-date\">Wednesday 23 September</p>",
      "css": ".ds-step{--paper:#dcd8cf;--panel:#f1eee7;--ink:#232420;--ink-2:#57564f;--hair:rgba(35,36,32,.16);--signal:#f04a00;--wash:rgba(35,36,32,.07);font-family:'Google Sans Flex Variable','Helvetica Neue',sans-serif;font-variation-settings:'ROND' 100;display:flex;align-items:baseline;gap:10px;font-size:88px;line-height:.86;font-weight:730;letter-spacing:-.045em;font-variant-numeric:tabular-nums;color:var(--ink)}.ds-step-unit{font-size:17px;font-weight:650;letter-spacing:0;color:var(--ink-2)}.ds-date{--paper:#dcd8cf;--panel:#f1eee7;--ink:#232420;--ink-2:#57564f;--hair:rgba(35,36,32,.16);--signal:#f04a00;--wash:rgba(35,36,32,.07);font-family:'Google Sans Flex Variable','Helvetica Neue',sans-serif;font-variation-settings:'ROND' 100;margin:10px 0 0;font-size:15px;font-weight:620;color:var(--ink)}"
    },
    {
      "name": "Day Cell",
      "kind": "nav",
      "refersTo": "day-cell",
      "description": "One step of the day strip; the selected day gets an orange bar, never a tint.",
      "html": "<div class=\"ds-strip\"><button class=\"ds-day\"><span class=\"ds-stack\"><i style=\"width:14px;background:#c91a09\"></i><i style=\"width:14px;background:#0055bf\"></i></span><span class=\"ds-num\">22</span></button><button class=\"ds-day\" aria-selected=\"true\"><span class=\"ds-stack\"><i style=\"width:14px;background:#f2cd37\"></i><i style=\"width:14px;background:#c91a09\"></i><i style=\"width:14px;background:#237841\"></i></span><span class=\"ds-num\">23</span></button></div>",
      "css": ".ds-strip{--paper:#dcd8cf;--panel:#f1eee7;--ink:#232420;--ink-2:#57564f;--hair:rgba(35,36,32,.16);--signal:#f04a00;--wash:rgba(35,36,32,.07);font-family:'Google Sans Flex Variable','Helvetica Neue',sans-serif;font-variation-settings:'ROND' 100;display:flex;gap:2px}.ds-day{position:relative;width:24px;height:56px;display:grid;grid-template-rows:1fr auto;justify-items:center;align-items:end;padding:0 0 6px;border:0;border-radius:6px;background:transparent;cursor:pointer}.ds-day:hover{background:var(--wash)}.ds-day:focus-visible{outline:2px solid var(--signal);outline-offset:2px}.ds-stack{display:flex;flex-direction:column-reverse;align-items:center;gap:1px;height:34px}.ds-stack i{display:block;height:3px;border-radius:1px}.ds-num{font-size:10px;font-weight:600;color:var(--ink-2);margin-top:3px;font-variant-numeric:tabular-nums}.ds-day[aria-selected=true]::after{content:'';position:absolute;left:6px;right:6px;bottom:1px;height:2px;border-radius:1px;background:var(--signal)}"
    },
    {
      "name": "Note Input",
      "kind": "input",
      "description": "Single underline, orange caret.",
      "html": "<input class=\"ds-note\" placeholder=\"What was it?\">",
      "css": ".ds-note{--paper:#dcd8cf;--panel:#f1eee7;--ink:#232420;--ink-2:#57564f;--hair:rgba(35,36,32,.16);--signal:#f04a00;--wash:rgba(35,36,32,.07);font-family:'Google Sans Flex Variable','Helvetica Neue',sans-serif;font-variation-settings:'ROND' 100;width:260px;font-size:14px;padding:5px 0;border:0;border-bottom:1px solid rgba(35,36,32,.32);background:transparent;color:var(--ink);outline:none;caret-color:var(--signal)}.ds-note:focus{border-bottom-color:var(--ink)}.ds-note::placeholder{color:var(--ink-2)}"
    },
    {
      "name": "Hover Tip",
      "kind": "card",
